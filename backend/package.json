{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:seed-admin": "tsx src/scripts/seed-dev-admin.ts",
    "seed:demo": "tsx src/scripts/seed-demo-organisation.ts",
    "deploy:indexes": "node dist/scripts/deploy-indexes.js",
    "migrate:phase9": "node dist/scripts/migrate-phase9.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-timeout=30000 tests/*.test.mjs",
    "test:integration": "npm run build && node --test --test-concurrency=1 --test-timeout=90000 tests/*.integration.mjs",
    "test:coverage": "npm run build && node --test --test-timeout=30000 --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-lines=75 tests/*.test.mjs",
    "test:coverage:critical": "npm run build && node ../scripts/verify-backend-critical-coverage.mjs",
    "test:release-harness": "node --test ../scripts/release-harness.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "mongoose": "^9.8.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
