      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "editorMode": "code", "expr": "100 * sum(rate(proxiai_http_requests_total{status_class=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(proxiai_http_requests_total[$__rate_interval])), 0.000000001)", "legendFormat": "5xx error rate", "range": true, "refId": "A" }
      ],
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries"
    },
